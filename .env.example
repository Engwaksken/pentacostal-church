# Copy this file to .env in the site folder and replace the values.
# .env is ignored by git and blocked from the web by .htaccess.
# Values may be wrapped in quotes if they contain spaces.

# Site address, with https:// (no trailing slash needed)
APP_URL=https://pentacostal.kemmytech.com

# Database login (from cPanel > MySQL Databases)
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

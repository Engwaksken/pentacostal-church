Options -MultiViews
RewriteEngine On

# Never serve the .env file (database login) or other dot-files such as .git.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
# cPanel PHP settings file.
RewriteRule (^|/)php\.ini$ - [F,L,NC]

# Root entry point canonicalizes to the site root.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Keep PHP handlers and downloads addressable as-is. Only canonicalize browser
# page requests, and never redirect a POST/other non-navigation request.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]) [NC]
# A word below counts only as a whole part of the path (between /, - or _), so "address" or "credit" pages still get clean URLs.
RewriteCond %1 !(?:^|[-_/])(?:process|download|export|receipt|pdf|certificates?|checkin|token|delete|remove|add|edit|collect|registration-links|report-data|cron)(?:[-_/]|$) [NC]
RewriteRule ^(.+?)\.php$ $1 [R=301,L,NE]

# Resolve extensionless page paths to their existing PHP files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [END]
